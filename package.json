{
  "name": "docker",
  "description": "Docker Compose stack manager for Cockpit, ported from Dockge",
  "type": "module",
  "main": "index.js",
  "repository": "git@github.com:avandeputte/cockpit-dockerstacks.git",
  "author": "",
  "license": "LGPL-2.1",
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "watch": "ESBUILD_WATCH='true' ./build.js",
    "build": "./build.js",
    "eslint": "eslint src/",
    "eslint:fix": "eslint --fix src/",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.{css,scss}\"",
    "test": "node --experimental-strip-types --no-warnings node_modules/qunit/bin/qunit.js test/unit/*.ts && python3 -B -m unittest discover -s test/unit -p 'test_*.py'"
  },
  "devDependencies": {
    "@types/react": "18.3.13",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "esbuild-wasm": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-config-standard-jsx": "11.0.0",
    "eslint-config-standard-react": "13.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "qunit": "3.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-formatter-pretty": "4.0.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.11.2",
    "@codemirror/legacy-modes": "6.5.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@lezer/highlight": "1.2.1",
    "@patternfly/patternfly": "6.6.1",
    "@patternfly/react-core": "6.6.2",
    "@patternfly/react-icons": "6.6.1",
    "@patternfly/react-styles": "6.6.1",
    "@patternfly/react-table": "6.6.2",
    "@patternfly/react-tokens": "6.6.1",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "argparse": "3.0.3",
    "composerize": "1.7.5",
    "dequal": "2.0.3",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "3.7.0",
    "gettext-parser": "9.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.8.1"
  }
}

pkgname=cockpit-docker
pkgver=VERSION
pkgrel=1
pkgdesc='Docker Compose stack manager for Cockpit (Dockge port)'
arch=('any')
url='https://github.com/avandeputte/cockpit-docker'
license=('LGPL-2.1-or-later' 'MIT')
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit docker)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
